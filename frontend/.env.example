# Frontend YEGA/Manda2 — copiar a .env (desarrollo)
# En producción los valores van en .env.production (sin secretos: Vite los compila al bundle)
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=Manda2
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development
# Token público de Mapbox — restringido por dominio en el panel de Mapbox
VITE_MAPBOX_TOKEN=pk.tu-token-publico
