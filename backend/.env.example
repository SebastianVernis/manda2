# Backend YEGA/Manda2 — copiar a .env y llenar. Nunca versionar el .env real.
NODE_ENV=development
PORT=5000

# Base de datos
MONGODB_URI=mongodb://localhost:27017/yega

# Firma de tokens (generar con: openssl rand -hex 32)
JWT_SECRET=cambia-esto-por-64-hex

# Origen permitido del frontend (separar con coma si son varios)
FRONTEND_URL=http://localhost:5173

# Correo saliente (OTP y notificaciones)
EMAIL_USER=tu-correo@dominio.com
EMAIL_PASS=tu-password-o-app-password
EMAIL_HOST=smtp.dominio.com
EMAIL_PORT=465
